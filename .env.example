# ---------- Runtime ----------
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
PYTHON_SERVICE_URL=http://127.0.0.1:8000
NODE_API_URL=http://127.0.0.1:5000

# ---------- Python inference service ----------
MODEL_BUNDLE=./student_risk_model.joblib

# ---------- Model compatibility ----------
# The shipped student_risk_model.joblib was trained on scikit-learn 1.9.0.
# python/requirements.txt pins that exact version. Do not upgrade scikit-learn
# without retraining the model, or you will see InconsistentVersionWarning.

# ---------- LLM provider ----------
# This project uses NVIDIA NIM exclusively. Gemini and Groq free-tier API
# access is not available in Hong Kong (regional restriction). The code
# supports them, but only NVIDIA is configured here.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Default model
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# Alternatives for the §3.3 model comparison.
# Uncomment one line at a time, restart `npm run dev`, then run
# `python python/test_fixed_set.py` to record that model's results.
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_MODEL=moonshotai/kimi-k3
# NVIDIA_MODEL=zai-org/glm-5-3
# NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
