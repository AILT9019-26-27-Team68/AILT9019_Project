# ---------- Runtime ----------
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
PYTHON_SERVICE_URL=http://127.0.0.1:8000
NODE_API_URL=http://127.0.0.1:5000

# ---------- Python inference service ----------
MODEL_BUNDLE=./student_risk_model.joblib

# ---------- Model compatibility ----------
# The shipped student_risk_model.joblib was trained on scikit-learn 1.9.0.
# python/requirements.txt pins that exact version. Do not upgrade scikit-learn
# without retraining the model, or you will see InconsistentVersionWarning.

# ---------- LLM provider (Alibaba Cloud Bailian) ----------
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=deepseek-v4.1-flash

# Reasoning tokens count against this budget; 4096 leaves room for the answer.
LLM_MAX_TOKENS=4096
