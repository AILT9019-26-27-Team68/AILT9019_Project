{
  "name": "student-risk-predictor",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "py:install": "pip install -r python/requirements.txt",
    "dev:py": "uvicorn python.inference_service:app --host 127.0.0.1 --port 8000 --reload",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -k -n PY,API,WEB \"npm run dev:py\" \"npm run dev:server\" \"npm run dev:client\"",
    "test:mcp": "python python/test_mcp.py",
    "test:model": "python python/test_model.py",
    "test:fixed": "python python/test_fixed_set.py"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
